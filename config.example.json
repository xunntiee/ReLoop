      "affiliate",
      "shopee",
      "shopee.vn",
      "s.shopee.vn",
      "shp.ee",
      "lazada",
      "lazada.vn",
      "tiki",
      "tiki.vn",
      "link shopee",
      "link lazada",
      "linktr.ee",
      "bit.ly",
      "tinyurl"
