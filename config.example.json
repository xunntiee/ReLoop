{
  "crawl": {
    "authStatePath": "storage/auth/default/threads.storage_state.json",
    "assetDir": "data/assets/threads",
    "baseUrl": "https://www.threads.com",
    "browserChannel": "chrome",
    "cacheTtlMinutes": 1440,
    "crawlAssets": true,
    "defaultConfigPath": "",
